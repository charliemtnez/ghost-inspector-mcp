node_modules/
dist/
*.tsbuildinfo

# Credentials — never commit any of these.
# Nothing here loads a .env; the key comes from the environment. These stay
# ignored anyway, so a file created out of habit can never be committed.
.env
.env.*
*.key
.gi-key
secrets/

# Local scratch: API dumps may contain organization IDs, hostnames and
# test-data identities. Nothing from a real account belongs in this repo.
scratch/
tmp/
*.local.json

.DS_Store
.idea/
.vscode/
