# Copy to .env for local development, or export these in the shell that
# launches your MCP client. .env is gitignored — never commit real values.

# Your PERSONAL Ghost Inspector API key.
# Ghost Inspector → hover your name (top right) → Account Settings → API Access.
# Keys are per user and can be regenerated at any time, which immediately
# revokes the previous one. Never share one key across a team.
GHOST_INSPECTOR_API_KEY=

# Your organization id. Required only for on-demand execution.
# Read it at runtime from GET /v1/organizations/ — do not hardcode it anywhere.
GHOST_INSPECTOR_ORG_ID=

# Mutating tools (create / update / move) are NOT registered unless this is
# exactly "true". Leave unset for a read-only server.
GHOST_INSPECTOR_ALLOW_WRITES=false
